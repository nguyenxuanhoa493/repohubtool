__pycache__/
.DS_Store
Thumbs.db
*.swp
*~

# Release packages - binaries are published to GitHub Releases, not tracked in git
dist/
*.zip
*.tar.gz
*.7z
*.rar

# Archived legacy patch scripts
tools/_archive/

# ---------------------------------------------------------------------------
# Large asset stores moved to GitHub Releases (see _src/publish_assets.py).
# The app downloads them over HTTP; they are not source.
# ---------------------------------------------------------------------------
/Themes/
/EmuIcons/zips/

# The plain database is a local build product; the .gz is the OTA payload and
# MUST stay in git: manifest.catalog.url is a repo-relative path that both old
# and new clients resolve against the branch.
catalog/roms_store.sqlite3

# Python build artefacts / editor backups
*.py[cod]
*.class
_src/*.orig
_src/*.bak

# Desktop runner (run-desktop.ps1)
.venv-desktop/
.sdcard-desktop/

# The store database the app installs into the payload directory at runtime
# (rh/updater.apply_catalog). 31 MB, and `git add -A` would happily ship it.
files/catalog/roms_store.sqlite3
files/catalog/roms_store.sqlite3.gz
files/.catalog_staging/
files/.update_staging/


# plans files. For dev purposes only, not to be committed to the repo.
plans/

# Secret configurations (never commit secrets to repo)
*secrets*.json
!files/rh/secrets.example.json
*secrets_local*
.env
.env.*